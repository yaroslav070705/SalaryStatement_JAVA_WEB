<?xml version="1.0" encoding="UTF-8"?>

<entity-mappings
        xmlns="http://xmlns.jcp.org/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://xmlns.jcp.org/xml/ns/persistence/orm
          http://xmlns.jcp.org/xml/ns/persistence/orm_2_2.xsd"
        version="2.2">

    <entity class="y.cloud.java.salary_statement_models.Employee" access="FIELD">

        <table name="Employees"/>

        <attributes>

            <id name="employee_id">
                <column name="employee_id"/>
                <generated-value generator="system-uuid"/>
            </id>

            <basic name="name">
                <column name="name"/>
            </basic>

            <basic name="surname">
                <column name="surname"/>
            </basic>

            <basic name="middle_name">
                <column name="middle_name"/>
            </basic>

            <basic name="birth_date">
                <column name="birth_date"/>
            </basic>

            <basic name="work_experience">
                <column name="work_experience"/>
            </basic>

            <basic name="fired">
                <column name="fired"/>
            </basic>

            <many-to-one name="post_id" target-entity="y.cloud.java.salary_statement_models.Post">
                <join-column name="post_id"/>
            </many-to-one>
        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.Post" access="FIELD">

        <table name="Posts"/>

        <attributes>

            <id name="post_id">
                <column name="post_id"/>
                <generated-value generator="system-uuid"/>
            </id>

            <basic name="post_name">
                <column name="post_name"/>
            </basic>

            <basic name="payout_value">
                <column name="payout_value"/>
            </basic>

        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.EmployeePostHistory" access="FIELD">

        <table name="Employees_Posts_History"/>

        <id-class class="y.cloud.java.salary_statement_models.EmployeePostHistoryPK"/>

        <attributes>
            <basic name="start_date">
                <column name="start_date"/>
            </basic>

            <basic name="end_date">
                <column name="end_date"/>
            </basic>

            <many-to-one name="employee_id"
                         target-entity="y.cloud.java.salary_statement_models.Employee"
                         id="true"
                         optional="false">
                <join-column name="employee_id"/>
            </many-to-one>

            <many-to-one name="post_id"
                         target-entity="y.cloud.java.salary_statement_models.Post"
                         id="true"
                         optional="false">
                <join-column name="post_id"/>
            </many-to-one>
        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.PayoutType" access="FIELD">

        <table name="Payout_Types"/>

        <attributes>

            <id name="payout_type_id">
                <column name="payout_type_id"/>
                <generated-value generator="system-uuid"/>
            </id>

            <basic name="payout_type">
                <column name="payout_type"/>
            </basic>

        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.Payout" access="FIELD">

        <table name="Payouts"/>

        <id-class class="y.cloud.java.salary_statement_models.PayoutPK"/>

        <attributes>
            <basic name="date">
                <column name="date"/>
            </basic>

            <basic name="value">
                <column name="value"/>
            </basic>

            <many-to-one name="employee_id"
                         target-entity="y.cloud.java.salary_statement_models.Employee"
                         id="true"
                         optional="false">
                <join-column name="employee_id"/>
            </many-to-one>

            <many-to-one name="payout_type_id"
                         target-entity="y.cloud.java.salary_statement_models.PayoutType"
                         id="true"
                         optional="false">
                <join-column name="payout_type_id"/>
            </many-to-one>
        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.Project" access="FIELD">

        <table name="Projects"/>

        <attributes>

            <id name="project_id">
                <column name="project_id"/>
                <generated-value generator="system-uuid"/>
            </id>

            <basic name="project_name">
                <column name="project_name"/>
            </basic>

            <basic name="start_date">
                <column name="start_date"/>
            </basic>

            <basic name="end_date">
                <column name="end_date"/>
            </basic>

        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.Role" access="FIELD">

        <table name="Roles"/>

        <attributes>

            <id name="role_id">
                <column name="role_id"/>
                <generated-value generator="system-uuid"/>
            </id>

            <basic name="role_name">
                <column name="role_name"/>
            </basic>

        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.ProjectSetup" access="FIELD">

        <table name="Projects_Setup"/>

        <id-class class="y.cloud.java.salary_statement_models.ProjectSetupPK"/>

        <attributes>
            <many-to-one name="role_id"
                         target-entity="y.cloud.java.salary_statement_models.Role"
                         optional="false">
                <join-column name="role_id"/>
            </many-to-one>

            <many-to-one name="employee_id"
                         target-entity="y.cloud.java.salary_statement_models.Employee"
                         id="true"
                         optional="false">
                <join-column name="employee_id"/>
            </many-to-one>

            <many-to-one name="project_id"
                         target-entity="y.cloud.java.salary_statement_models.Project"
                         id="true"
                         optional="false">
                <join-column name="project_id"/>
            </many-to-one>
        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.EmployeeRoleHistory" access="FIELD">

        <table name="Employees_Roles_History"/>

        <id-class class="y.cloud.java.salary_statement_models.EmployeeRoleHistoryPK"/>

        <attributes>
            <basic name="start_date">
                <column name="start_date"/>
            </basic>

            <basic name="end_date">
                <column name="end_date"/>
            </basic>

            <many-to-one name="employee_id"
                         target-entity="y.cloud.java.salary_statement_models.Employee"
                         id="true"
                         optional="false">
                <join-column name="employee_id"/>
            </many-to-one>

            <many-to-one name="project_id"
                         target-entity="y.cloud.java.salary_statement_models.Project"
                         id="true"
                         optional="false">
                <join-column name="project_id"/>
            </many-to-one>

            <many-to-one name="role_id"
                         target-entity="y.cloud.java.salary_statement_models.Role"
                         id="true"
                         optional="false">
                <join-column name="role_id"/>
            </many-to-one>
        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.RolePayoutValue" access="FIELD">

        <table name="Role_Payout_Value"/>

        <id-class class="y.cloud.java.salary_statement_models.RolePayoutValuePK"/>

        <attributes>

            <basic name="value">
                <column name="value"/>
            </basic>

            <many-to-one name="project_id"
                         target-entity="y.cloud.java.salary_statement_models.Project"
                         id="true"
                         optional="false">
                <join-column name="project_id"/>
            </many-to-one>

            <many-to-one name="role_id"
                         target-entity="y.cloud.java.salary_statement_models.Role"
                         id="true"
                         optional="false">
                <join-column name="role_id"/>
            </many-to-one>
        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.WorkExperiencePayoutValue" access="FIELD">

        <table name="Work_Experience_Payout_Value"/>

        <attributes>

            <id name="experience_id">
                <column name="experience_id"/>
                <generated-value generator="system-uuid"/>
            </id>

            <basic name="work_experience">
                <column name="work_experience"/>
            </basic>

            <basic name="value">
                <column name="value"/>
            </basic>

        </attributes>

    </entity>

    <entity class="y.cloud.java.salary_statement_models.BonusPayoutValue" access="FIELD">

        <table name="Bonus_Payouts_Values"/>

        <attributes>

            <id name="payout_type_id">
                <column name="payout_type_id"/>
            </id>

            <basic name="value">
                <column name="value"/>
            </basic>

        </attributes>

    </entity>

</entity-mappings>
